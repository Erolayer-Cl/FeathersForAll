# Copiar a .env (no versionado). 12-Factor 3: configuración por entorno.
PORT=3000
LOG_LEVEL=info

# Proveedor LLM. En desarrollo: Ollama local (`ollama serve`).
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT_MS=60000
# 0–1: más bajo = respuestas más enfocadas; más alto = más variadas
LLM_TEMPERATURE=0.6
# Tokens de contexto del LLM. El RAG agrega apuntes al prompt; 2048 se queda corto.
LLM_NUM_CTX=4096
# Cuánto mantiene Ollama los modelos en memoria sin uso (~3,4 GB de RAM). Con su valor por defecto (5m)
# la primera pregunta tras una pausa tarda ~19 s en CPU por la carga del modelo.
LLM_KEEP_ALIVE=30m

# --- RAG (tutor anclado a los apuntes del curso) ---
# Embeddings (`ollama pull bge-m3`): 1024 dimensiones, igual que vector(1024) en 02_s06_ajustes.sql.
EMBEDDING_MODEL=bge-m3
# Fragmentos que se pasan al LLM y similitud mínima (0–1) para considerarlos relevantes.
# Ajústalo con `npm run rag:search -- "<pregunta>"`.
RAG_TOP_K=4
RAG_MIN_SCORE=0.5
RAG_CHUNK_CHARS=800
# Solo sin DATABASE_URL: los vectores van a este archivo JSON (está en .gitignore).
RAG_STORE_PATH=data/rag-store.json

# --- PostgreSQL ---
# Con Docker: `docker compose up -d` crea la base con estas mismas claves (compose.yaml).
# Sin DATABASE_URL: solo chat + RAG en archivo. Con DATABASE_URL: notas + RAG en pgvector (apuntes_curso / apuntes_embeddings).
# Usuario feathersforall_app: SIN superusuario ni BYPASSRLS, o el RLS no aplica.
DATABASE_URL=postgres://feathersforall_app:cambiar@localhost:5432/feathersforall
# Solo para `npm run db:setup` (crear la base sin psql). Superusuario. No se usa en la API.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/feathersforall
# Secreto HS256 de los JWT (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Duración del token que entrega POST /v1/auth/login (segundos). Por defecto 8 h.
# JWT_TTL_SECONDS=28800

# Pruebas de integración (crean y borran bases temporales): superusuario del compose.
# `npm test` no lee este archivo: expórtala al correr las pruebas.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Chat SIN token (solo desarrollo): colegio y curso por defecto = Colegio Demo A y Matemáticas 7°A (90_seed_demo.sql).
# Con token, el colegio sale SIEMPRE del JWT.
DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111
DEFAULT_COURSE_ID=c0000000-0000-0000-0000-000000000001
