{
  "name": "@feathersforall/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de FeathersForAll (monolito modular Express): tutor con RAG (Ollama + pgvector) y notas sobre PostgreSQL.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-lines=70",
    "lint": "eslint .",
    "ingest": "node --env-file-if-exists=.env scripts/ingest.js",
    "rag:search": "node --env-file-if-exists=.env scripts/search.js",
    "db:setup": "node --env-file-if-exists=.env scripts/db-setup.js",
    "dev:token": "node --env-file-if-exists=.env scripts/dev-token.js",
    "tutor:purgar": "node --env-file-if-exists=.env src/jobs/purgar-conversaciones.js",
    "hash:password": "node scripts/hash-password.js",
    "test:postman": "npx --yes newman@6 run requests/postman/FeathersForAll.postman_collection.json -e requests/postman/FeathersForAll.local.postman_environment.json"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  }
}
