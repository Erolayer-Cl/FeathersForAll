{
  "name": "@aulaviva/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "Cliente TypeScript tipado de la API de AulaViva, generado desde api/openapi.yaml (contract-first).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript ../../api/openapi.yaml -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.0"
  }
}
