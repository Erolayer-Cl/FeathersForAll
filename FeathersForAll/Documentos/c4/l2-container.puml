@startuml l2-container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Diagrama de Contenedor (C4 Nivel 2) — AulaViva / FeathersForAll (con cloud, S04)

Person(docente, "Docente", "Crea cursos/evaluaciones y revisa resultados")
Person(estudiante, "Estudiante", "Rinde evaluaciones y consulta Tutor IA")
Person(admin, "Admin. colegio", "Gestiona tenant, cursos y usuarios")

System_Boundary(aulaviva, "FeathersForAll (Aplicación)") {
  Container(web, "Aplicación Web (Frontend)", "HTML + CSS + JavaScript · Vercel", "Interfaz de docentes, estudiantes y administradores")
  Container(api, "Backend monolítico (API)", "Node.js + Express · Render", "Lógica de negocio, autenticación, RBAC y validación de tenant en cada request")
  Container(tutor, "Servicio Tutor IA", "RAG + pgvector", "Tutor por curso/tenant (hosting por confirmar, ver ADR 0003)")
  Container(worker, "Worker / cola", "Node.js + worker · Render", "Trabajos asíncronos: consultas al LLM y notificaciones")
  ContainerDb(db, "Base de datos", "PostgreSQL + pgvector · Render", "Cursos, evaluaciones, resultados y embeddings; tenant_id + RLS")
}

System_Ext(llm, "Proveedor LLM", "API externa")
System_Ext(email, "Email / SMTP")
System_Ext(auth, "Auth institucional", "SSO / OAuth2")
System_Ext(secrets, "AWS Secrets Manager", "Gestión de secretos")
System_Ext(cw, "Amazon CloudWatch", "Logs + métricas + alarmas")

Rel(docente, web, "Usa", "HTTPS")
Rel(estudiante, web, "Usa", "HTTPS")
Rel(admin, web, "Usa", "HTTPS")

Rel(web, api, "Llama", "HTTPS / JSON")
Rel(api, db, "Lee/escribe", "SQL")
Rel(api, tutor, "Consultas del tutor", "HTTP / JSON")
Rel(api, worker, "Encola tareas", "AWS SQS")
Rel(tutor, db, "Apuntes y embeddings del curso", "SQL")
Rel(worker, llm, "Consulta el modelo", "HTTPS / API")
Rel(worker, email, "Envía notificaciones", "SMTP / API")
Rel(api, secrets, "Lee secretos (credenciales, API keys)", "AWS SDK")
Rel(api, cw, "Logs / métricas", "CloudWatch")
Rel(worker, cw, "Logs / métricas", "CloudWatch")
Rel(api, auth, "Valida identidad", "SSO / OAuth2")

@enduml
